# Copy to .env for local runs. Never commit the real .env.
DATABASE_URL=postgresql://postgres@localhost/farmfresh
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
# production refuses to start with placeholder secrets; leave as development for local runs
APP_ENV=development
# Admin bootstrapped by `flask ensure-admin` (run on every container start)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (https://dashboard.razorpay.com → Test mode → API Keys). Blank = demo payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: live mandi prices from data.gov.in (AGMARKNET). Then run: flask import-prices
DATA_GOV_API_KEY=
